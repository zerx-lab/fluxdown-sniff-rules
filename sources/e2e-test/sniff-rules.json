{
  "namespace": "e2e-test",
  "hosts": [
    "example.com"
  ],
  "rules": [
    {
      "id": "community.e2e-test.xyz-video",
      "version": 2,
      "tier": "community",
      "title": "E2E：example.com 的 .xyz 视频（v2）",
      "stage": "response",
      "match": {
        "host": [
          "example.com"
        ],
        "ext": [
          "xyz"
        ]
      },
      "action": {
        "kind": "resource",
        "type": "video"
      }
    }
  ],
  "tests": [
    {
      "name": "识别 xyz 视频",
      "call": "classifyResponse",
      "args": [
        {
          "url": "https://cdn.example.com/a.xyz",
          "pageUrl": "https://www.example.com/",
          "size": 0,
          "attachment": false
        }
      ],
      "expect": {
        "decision": "resource",
        "type": "video",
        "rule": {
          "id": "community.e2e-test.xyz-video"
        }
      }
    }
  ]
}
