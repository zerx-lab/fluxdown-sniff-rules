{
  "rules": [
    {
      "id": "official.youtube.miniplayer-float",
      "version": 1,
      "tier": "official",
      "title": "YouTube：迷你播放器里浮钮避开顶部的展开 / 关闭按钮",
      "stage": "page",
      "match": {
        "pageHost": [
          "youtube.com"
        ]
      },
      "action": {
        "kind": "player",
        "selector": ".html5-video-player.ytp-player-minimized, .html5-video-player.ytp-miniplayer-active, ytd-miniplayer[active]",
        "float": "inset",
        "top": 52
      }
    }
  ],
  "tests": [
    {
      "name": "YouTube 页面下发迷你播放器顶部避让",
      "call": "pageHints",
      "args": [
        "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
      ],
      "expect": {
        "players": [],
        "insets": [
          {
            "selector": ".html5-video-player.ytp-player-minimized, .html5-video-player.ytp-miniplayer-active, ytd-miniplayer[active]",
            "top": 52
          }
        ]
      }
    },
    {
      "name": "其它站点不生效",
      "call": "pageHints",
      "args": [
        "https://www.example.com/watch?v=1"
      ],
      "expect": {
        "players": [],
        "insets": []
      }
    }
  ]
}
